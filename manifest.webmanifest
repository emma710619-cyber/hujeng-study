<script>
const DATA=[{"q": "行政法最主要規範何種法律關係？", "o": ["私人間日常買賣", "行政主體行使公權力所生關係", "純道德關係", "國際私法關係"], "a": 1, "e": "行政法核心在行政主體行使公權力及其與人民、其他行政主體間的公法關係。", "tag": "基本概念"}, {"q": "判斷公法與私法時，何者最符合修正主體說？", "o": ["只要國家參與就是公法", "規範是否專門賦予行政主體公權力地位", "看金額大小", "看契約名稱"], "a": 1, "e": "修正主體說觀察規範是否專門以行政主體為權利義務歸屬者。", "tag": "公私法"}, {"q": "政府機關向文具行購買影印紙，通常屬於何種關係？", "o": ["必然公法", "通常私法買賣", "刑事關係", "國際法"], "a": 1, "e": "國家作為一般交易主體時，仍可能成立私法契約。", "tag": "公私法"}, {"q": "行政程序法第4條的核心為何？", "o": ["行政行為不受一般原則拘束", "行政行為受法律及一般法律原則拘束", "只有法院受法律拘束", "行政規則高於法律"], "a": 1, "e": "第4條明定依法行政及一般法律原則拘束。", "tag": "依法行政"}, {"q": "法律優位原則的核心意義為何？", "o": ["任何行政行為均須有明文授權", "行政行為不得牴觸法律", "命令可修改法律", "行政慣例高於法律"], "a": 1, "e": "法律優位是消極要求：行政行為不能違反法律。", "tag": "法律優位"}, {"q": "法律保留原則主要處理何種問題？", "o": ["是否有法律依據", "是否超過訴願期間", "是否公開開會", "是否使用書面"], "a": 0, "e": "法律保留要求一定重要事項須有法律或法律明確授權。", "tag": "法律保留"}, {"q": "法規命令與母法牴觸時，原則上如何？", "o": ["優先適用命令", "命令不得牴觸法律", "由機關任選", "兩者同效力"], "a": 1, "e": "下位規範不得牴觸上位法律。", "tag": "法源"}, {"q": "行政規則原則上主要規範何者？", "o": ["行政內部秩序與運作", "直接創設刑罰", "修改法律", "廢止憲法"], "a": 0, "e": "行政規則主要發生內部拘束力。", "tag": "法源"}, {"q": "下列何者屬法規命令典型特徵？", "o": ["針對特定人的一次決定", "基於法律授權對多數不特定人民發生外部效力", "純私人契約", "法院判決"], "a": 1, "e": "法規命令具有抽象、一般及外部效力。", "tag": "法規命令"}, {"q": "行政規則可否直接取代法律限制人民權利？", "o": ["原則可以", "原則不可以", "只要承辦人同意即可", "只要未公告即可"], "a": 1, "e": "內部規則不能成為欠缺法律依據的外部權利限制。", "tag": "行政規則"}, {"q": "授權明確性通常要求法律授權的哪些要素可得確定？", "o": ["目的、內容與範圍", "承辦人姓名", "預算科目", "新聞評價"], "a": 0, "e": "授權目的、內容與範圍須達具體明確程度。", "tag": "授權明確性"}, {"q": "授權明確程度與何者關係最密切？", "o": ["人民權利受影響程度", "機關辦公地點", "承辦年資", "文件顏色"], "a": 0, "e": "對權利影響越重大，授權明確要求通常越高。", "tag": "授權明確性"}, {"q": "依憲法法庭112年憲判字第5號，判斷授權明確性應如何？", "o": ["只看單一條文文字", "可從母法整體規範與關聯意義判斷", "只看行政機關解釋", "完全不需可預見"], "a": 1, "e": "該判決強調整體解釋，並要求與權利影響相稱。", "tag": "實務"}, {"q": "行政程序法第5條要求行政行為內容如何？", "o": ["抽象", "明確", "秘密", "一律口頭"], "a": 1, "e": "第5條為行政行為明確性要求。", "tag": "明確性"}, {"q": "使用「公共利益」等不確定概念必然違反明確性嗎？", "o": ["必然違反", "不必然，仍可經解釋、預見及審查", "只要機關說明即可免審查", "完全不受法院審查"], "a": 1, "e": "明確性不排除不確定法律概念，重點是可理解、可預見及可審查。", "tag": "明確性"}, {"q": "平等原則是否要求所有人一律完全相同處理？", "o": ["是", "否，合理差異可作不同處理", "只對公務員適用", "只對稅法適用"], "a": 1, "e": "平等要求禁止無正當理由差別待遇。", "tag": "平等"}, {"q": "行政機關對事實相同案件作不同處理，何者最重要？", "o": ["是否有正當理由", "是否同一承辦人", "是否同一天", "是否同一頁紙"], "a": 0, "e": "有合理、正當的差別理由，未必違反平等。", "tag": "平等"}, {"q": "人民可否主張其他人曾獲違法利益，自己也應同樣獲得？", "o": ["可以，違法也平等", "不可以，原則上無違法平等", "只要人數多即可", "只要媒體報導即可"], "a": 1, "e": "行政自我拘束不使違法慣例合法化。", "tag": "自我拘束"}, {"q": "行政自我拘束通常以何者為前提？", "o": ["一次偶發處理", "合法且持續一致的行政實務", "違法命令", "私人承諾"], "a": 1, "e": "須有合法、持續且一致的處理基準或實務。", "tag": "自我拘束"}, {"q": "比例原則第一層適當性在問什麼？", "o": ["手段是否有助目的達成", "是否有最小侵害手段", "利益是否顯失均衡", "是否有管轄"], "a": 0, "e": "適當性檢查手段與目的間的促進關係。", "tag": "比例"}, {"q": "必要性原則的判斷核心為何？", "o": ["有無更嚴厲手段", "有無同樣有效而侵害較小手段", "是否完全無成本", "是否有新聞支持"], "a": 1, "e": "在同等有效手段中，應選擇侵害最小者。", "tag": "比例"}, {"q": "狹義比例原則主要進行何種判斷？", "o": ["管轄判斷", "損害與公益的均衡", "法規公布程序", "代理權"], "a": 1, "e": "狹義比例是利益衡量，避免代價與目的顯失均衡。", "tag": "比例"}, {"q": "某措施完全無助於法定目的，違反比例原則哪一層？", "o": ["適當性", "必要性", "狹義比例", "平等"], "a": 0, "e": "無助於目的即欠缺適當性。", "tag": "比例"}, {"q": "已有同樣有效且侵害較小方式，機關仍採較嚴厲方式，主要違反何者？", "o": ["必要性", "法律優位", "管轄恆定", "誠信"], "a": 0, "e": "此為典型必要性問題。", "tag": "比例"}, {"q": "手段雖有效且無替代方案，但造成極端重大損害，可能違反何者？", "o": ["狹義比例", "適當性", "管轄", "行政協助"], "a": 0, "e": "須衡量手段損害與目的利益是否顯失均衡。", "tag": "比例"}, {"q": "行政程序法第8條同時規定哪些原則？", "o": ["誠實信用與信賴保護", "平等與比例", "公開與秘密", "管轄與代理"], "a": 0, "e": "第8條規定誠信方法及正當合理信賴保護。", "tag": "信賴保護"}, {"q": "信賴保護的「信賴基礎」通常來自何者？", "o": ["行政機關處分、表示或持續實務", "人民單方願望", "網路留言", "私人猜測"], "a": 0, "e": "須有可歸責於公權力的信賴基礎。", "tag": "信賴保護"}, {"q": "人民基於行政表示已投入成本，屬於何項要件？", "o": ["信賴表現", "信賴基礎", "管轄", "適當性"], "a": 0, "e": "人民須有基於信賴的具體安排或處分。", "tag": "信賴保護"}, {"q": "人民以詐欺取得有利處分，通常如何？", "o": ["信賴仍一律保護", "信賴通常不值得保護", "必須永久維持", "只看金額"], "a": 1, "e": "以詐欺、脅迫或賄賂取得者，通常不具值得保護性。", "tag": "信賴保護"}, {"q": "信賴保護成立後，是否必然維持原狀？", "o": ["必然", "不必然，仍須公益衡量並可採過渡或補償", "一律撤銷", "一律刑罰"], "a": 1, "e": "保護方式可能是存續、過渡或補償。", "tag": "信賴保護"}, {"q": "禁止不當聯結原則主要禁止什麼？", "o": ["將無實質關聯的利益與負擔強行連結", "依法收規費", "要求補正必要文件", "告知救濟"], "a": 0, "e": "條件、負擔與行政目的間須有合理關聯。", "tag": "不當聯結"}, {"q": "行政機關只蒐集不利證據、不理有利資料，可能違反何者？", "o": ["有利不利一律注意", "法律不溯及既往", "罪刑法定", "契約自由"], "a": 0, "e": "行政程序法第9條、第36條要求客觀、全面調查。", "tag": "職權調查"}, {"q": "行政程序中的證據調查原則上採何種模式？", "o": ["純當事人進行", "職權調查", "陪審制", "完全自由心證且無理由"], "a": 1, "e": "行政機關依職權調查，不受當事人主張拘束。", "tag": "職權調查"}, {"q": "行政機關作成決定時，對事實真偽應依何者判斷？", "o": ["論理及經驗法則", "首長個人偏好", "抽籤", "媒體票選"], "a": 0, "e": "行政程序法第43條要求斟酌全部資料並依論理及經驗法則。", "tag": "證據"}, {"q": "裁量是指何者？", "o": ["機關可在法律容許的多種結果中選擇", "完全不受法律拘束", "可任意違反目的", "法院不得審查任何事項"], "a": 0, "e": "裁量仍受範圍、目的及一般原則拘束。", "tag": "裁量"}, {"q": "超過法定裁罰上限，屬何種裁量瑕疵？", "o": ["裁量逾越", "裁量怠惰", "判斷餘地", "行政協助"], "a": 0, "e": "選擇超出法定界限即裁量逾越。", "tag": "裁量"}, {"q": "法律賦予裁量，機關卻認為只能作唯一決定，屬何者？", "o": ["裁量怠惰", "裁量逾越", "適當性", "信賴表現"], "a": 0, "e": "未實際行使應行使的裁量即裁量怠惰。", "tag": "裁量"}, {"q": "因私人恩怨作成較重處分，主要屬何種瑕疵？", "o": ["裁量濫用", "裁量怠惰", "管轄移送", "法規命令"], "a": 0, "e": "使用與法定目的無關的考量，屬裁量濫用。", "tag": "裁量"}, {"q": "行政程序法第10條要求裁量符合何者？", "o": ["法定範圍與授權目的", "承辦人偏好", "媒體意見", "私人契約"], "a": 0, "e": "裁量不得逾越範圍，並應符合法規授權目的。", "tag": "裁量"}, {"q": "裁量基準可否完全取代個案判斷？", "o": ["可以，永遠機械適用", "不可以，仍須保留個案衡量", "只要未公開即可", "由人民決定"], "a": 1, "e": "機械套用可能構成裁量怠惰。", "tag": "裁量"}, {"q": "不確定法律概念的典型例子為何？", "o": ["重大危害", "10日", "新臺幣5萬元", "上午9時"], "a": 0, "e": "重大、公共利益等概念須透過解釋與涵攝具體化。", "tag": "不確定概念"}, {"q": "不確定法律概念原則上是否受法院審查？", "o": ["原則受審查", "完全不受審查", "只由立法院審查", "由媒體審查"], "a": 0, "e": "原則上可全面審查；特殊領域才可能有有限判斷餘地。", "tag": "司法審查"}, {"q": "判斷餘地是否等於行政機關完全自由？", "o": ["是", "否，仍受程序、事實、目的與一般原則審查", "只要專業就完全免審查", "只限私法"], "a": 1, "e": "判斷餘地仍有審查界線。", "tag": "司法審查"}, {"q": "行政機關管轄權原則上依何者決定？", "o": ["組織法規或其他行政法規", "長官口頭決定", "新聞公告", "人民選擇"], "a": 0, "e": "行政程序法第11條。", "tag": "管轄"}, {"q": "管轄權可否未依法規任意設定或變更？", "o": ["可以", "不可以", "只要承辦同意即可", "只要對人民不利即可"], "a": 1, "e": "管轄權非依法規不得設定或變更。", "tag": "管轄"}, {"q": "機關發現自己無管轄權時，原則上應如何？", "o": ["逕行駁回不通知", "移送有管轄權機關並通知當事人", "自行保留案件", "銷毀資料"], "a": 1, "e": "行政程序法第17條採移送制度。", "tag": "管轄"}, {"q": "人民在法定期間向無管轄權機關提出申請，後移送有管轄權機關，期間效果如何？", "o": ["一律逾期", "視同已在法定期間向有管轄權機關提出", "重新起算且不計前次", "由承辦決定"], "a": 1, "e": "第17條保障人民期間利益。", "tag": "管轄"}, {"q": "委任通常是將權限交由何者執行？", "o": ["所屬下級機關", "私人公司", "法院", "立法院"], "a": 0, "e": "委任是上下隸屬機關間的權限移轉。", "tag": "權限移轉"}, {"q": "委託行政機關通常指交由何者？", "o": ["不相隸屬行政機關", "所屬下級機關", "當事人代理人", "法院"], "a": 0, "e": "行政程序法第15條第2項。", "tag": "權限移轉"}, {"q": "行政機關將部分公權力委託民間團體或個人，受託者在範圍內如何定位？", "o": ["視為行政機關", "視為法院", "純私人且不受行政法", "視為立法機關"], "a": 0, "e": "行政程序法第2條第3項。", "tag": "公權力委託"}, {"q": "委任、委託事項及法規依據通常應如何？", "o": ["公告並刊登政府公報或新聞紙", "完全保密", "只口頭告知承辦人", "只通知一位人民"], "a": 0, "e": "法定公告是權限移轉的重要要求。", "tag": "權限移轉"}, {"q": "行政程序法第3條所列不適用程序規定事項，是否表示完全不受任何行政法原則拘束？", "o": ["是", "否，通常只是本法程序規定不適用，不等於完全脫離憲法與一般原則", "只受民法", "只受刑法"], "a": 1, "e": "不適用特定程序規定，不代表公權力可恣意。", "tag": "適用範圍"}, {"q": "國籍變更行為依行政程序法第3條如何？", "o": ["不適用本法程序規定", "一律適用全部程序", "屬私法", "屬刑事偵查"], "a": 0, "e": "第3條第3項第2款明列國籍變更行為。", "tag": "適用範圍"}, {"q": "受託行使公權力的個人或團體，於何範圍內視為行政機關？", "o": ["委託範圍內", "所有私人活動", "僅收費時", "永遠"], "a": 0, "e": "僅於受託行使公權力的範圍內。", "tag": "行政機關"}, {"q": "行政機關對事件管轄權有無，應如何處理？", "o": ["依職權調查", "等待對造抗辯才調查", "完全不調查", "由媒體判斷"], "a": 0, "e": "管轄屬機關應主動確認事項。", "tag": "管轄"}, {"q": "法律優位與法律保留的正確比較為何？", "o": ["前者問不得牴觸，後者問須有依據", "兩者完全相同", "前者只適用給付行政", "後者只適用內規"], "a": 0, "e": "這是最核心的區分。", "tag": "依法行政"}, {"q": "某機關以內部作業要點新增人民必須繳納的費用，最直接涉及何原則？", "o": ["法律保留", "適當性", "管轄恆定", "信賴表現"], "a": 0, "e": "創設人民金錢義務須有足夠法律依據。", "tag": "法律保留"}, {"q": "某命令雖有授權，但增加母法明確排除的義務，主要違反何者？", "o": ["法律優位及授權界限", "信賴表現", "行政協助", "代理制度"], "a": 0, "e": "命令不得牴觸母法或逾越授權。", "tag": "法律優位"}, {"q": "相同案件長期均核准，本案無理由突然否准，最可能涉及何者？", "o": ["平等與行政自我拘束", "罪刑法定", "私法自治", "國際法"], "a": 0, "e": "合法一致實務可能形成自我拘束。", "tag": "自我拘束"}, {"q": "行政措施要求申請人捐款給與案件無關團體才予核准，最可能違反何者？", "o": ["禁止不當聯結", "適當性而已", "管轄", "代理"], "a": 0, "e": "捐款與核准目的若無實質關聯，即構成不當聯結。", "tag": "不當聯結"}, {"q": "本章解題最合理的順序為何？", "o": ["先權限、再法源、後一般原則與裁量", "先看結果喜不喜歡", "先看承辦年資", "先看媒體聲量"], "a": 0, "e": "行政法基本審查架構應先確認權限與法源，再審查手段。", "tag": "總整理"}];
const KEY='hujeng_v6_admin_ch1';
let state=JSON.parse(localStorage.getItem(KEY)||'{"answers":{},"revealed":{},"fav":{}}');
function save(){localStorage.setItem(KEY,JSON.stringify(state));updateStatus()}
function render(mode='all'){
 const root=document.getElementById('questions'); root.innerHTML='';
 DATA.forEach((x,i)=>{
  if(mode==='wrong' && (state.answers[i]===undefined || state.answers[i]===x.a)) return;
  const d=document.createElement('div');d.className='question';
  let opts=x.o.map((o,j)=>`<label class="option ${state.revealed[i]?(j===x.a?'correct':(state.answers[i]===j?'wrong':'')):''}"><input type="radio" name="q${i}" value="${j}" ${state.answers[i]===j?'checked':''} onchange="answer(${i},${j})"> ${String.fromCharCode(65+j)}. ${o}</label>`).join('');
  d.innerHTML=`<div class="qhead"><b>${i+1}. ${x.q}</b><span class="tag">${x.tag}</span></div>${opts}<div class="toolbar"><button onclick="reveal(${i})">顯示解析</button><button class="secondary" onclick="fav(${i})">${state.fav[i]?'★ 已收藏':'☆ 收藏'}</button></div><div class="explain" style="display:${state.revealed[i]?'block':'none'}"><b>答案：${String.fromCharCode(65+x.a)}</b><br>${x.e}</div>`;
  root.appendChild(d);
 });
 updateStatus();
}
function answer(i,j){state.answers[i]=j;save()}
function reveal(i){state.revealed[i]=true;save();render()}
function fav(i){state.fav[i]=!state.fav[i];save();render()}
function showAll(){DATA.forEach((_,i)=>state.revealed[i]=true);save();render()}
function filterWrong(){render('wrong')}
function resetAll(){if(confirm('確定清除本章所有作答、解析與收藏紀錄？')){state={answers:{},revealed:{},fav:{}};save();render()}}
function updateStatus(){
 let n=Object.keys(state.answers).length,c=0;DATA.forEach((x,i)=>{if(state.answers[i]===x.a)c++});
 document.getElementById('status').textContent=`已作答 ${n} / ${DATA.length}｜答對 ${c} 題｜收藏 ${Object.values(state.fav).filter(Boolean).length} 題`;
 document.getElementById('bar').style.width=(n/DATA.length*100)+'%';
}

function exportProgress(){
  const payload={
    app:"戶政國考學習平台",
    version:"V7-PWA",
    exportedAt:new Date().toISOString(),
    storageKey:KEY,
    data:state
  };
  const blob=new Blob([JSON.stringify(payload,null,2)],{type:"application/json"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url;
  a.download="戶政國考學習進度_"+new Date().toISOString().slice(0,10)+".json";
  a.click();
  URL.revokeObjectURL(url);
  document.getElementById("syncMsg").textContent="已匯出學習進度。";
}
function importProgress(event){
  const file=event.target.files[0];
  if(!file)return;
  const reader=new FileReader();
  reader.onload=()=>{
    try{
      const payload=JSON.parse(reader.result);
      const imported=payload.data||payload;
      if(!imported.answers||!imported.revealed||!imported.fav) throw new Error("格式不符");
      state=imported;
      save();
      render();
      document.getElementById("syncMsg").textContent="匯入成功，已套用學習進度。";
    }catch(err){
      document.getElementById("syncMsg").textContent="匯入失敗：檔案格式不正確。";
    }
  };
  reader.readAsText(file);
}
if("serviceWorker" in navigator){
  window.addEventListener("load",()=>navigator.serviceWorker.register("./service-worker.js"));
}
let deferredPrompt=null;
window.addEventListener("beforeinstallprompt",e=>{
  e.preventDefault();
  deferredPrompt=e;
  document.getElementById("installPanel").hidden=false;
});
document.getElementById("installBtn")?.addEventListener("click",async()=>{
  if(!deferredPrompt)return;
  deferredPrompt.prompt();
  await deferredPrompt.userChoice;
  deferredPrompt=null;
  document.getElementById("installPanel").hidden=true;
});

render();
</script>
</body></html>